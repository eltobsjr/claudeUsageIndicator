<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <enum id="org.gnome.shell.extensions.claude-usage.color-theme">
    <value nick="auto" value="0"/>
    <value nick="sistema" value="1"/>
    <value nick="catppuccin" value="2"/>
    <value nick="verde" value="3"/>
    <value nick="laranja" value="4"/>
  </enum>

  <enum id="org.gnome.shell.extensions.claude-usage.label-format">
    <value nick="full"     value="0"/>
    <value nick="pct-only" value="1"/>
    <value nick="spark"    value="2"/>
  </enum>

  <enum id="org.gnome.shell.extensions.claude-usage.panel-position">
    <value nick="right"      value="0"/>
    <value nick="right-edge" value="1"/>
    <value nick="left"       value="2"/>
    <value nick="left-edge"  value="3"/>
  </enum>

  <schema id="org.gnome.shell.extensions.claude-usage"
          path="/org/gnome/shell/extensions/claude-usage/">

    <key name="refresh-interval" type="i">
      <default>30</default>
      <range min="10" max="600"/>
      <summary>Intervalo de atualização (segundos)</summary>
    </key>

    <key name="show-icon" type="b">
      <default>true</default>
      <summary>Mostrar o ícone na barra</summary>
    </key>

    <key name="color-theme" enum="org.gnome.shell.extensions.claude-usage.color-theme">
      <default>'auto'</default>
      <summary>Tema de cores do popup</summary>
    </key>

    <key name="label-format" enum="org.gnome.shell.extensions.claude-usage.label-format">
      <default>'full'</default>
      <summary>Formato do label na barra superior</summary>
    </key>

    <key name="panel-position" enum="org.gnome.shell.extensions.claude-usage.panel-position">
      <default>'right'</default>
      <summary>Posição do indicador na barra superior</summary>
    </key>

  </schema>
</schemalist>
